<%- include('partials/head') %>
<div class="head-row">
  <h1>Canvis a la federació</h1>
  <div class="row-actions">
    <% if (list.some((c) => !c.seen)) { %><form method="post" action="/canvis/vist" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small">Marcar com a vist</button></form><% } %>
    <% if (isCoord) { %><form method="post" action="/sincronitzar" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small primary" <%= syncing ? 'disabled' : '' %>><%= syncing ? 'Sincronitzant…' : 'Sincronitzar ara' %></button></form><% } %>
  </div>
</div>
<p class="muted">Cada dia a les 7:00 es llegeixen la FECAPA i l'OK Liga. Aquí surten els partits del club que s'han mogut, són nous o ja no hi són. Si un canvi provoca bloquejos, també t'arriba per correu.</p>
<% if (!list.length) { %><section class="card"><p class="muted">Encara no s'ha detectat cap canvi.</p></section><% } %>
<section class="card list">
<% list.forEach((c) => { %>
  <a class="item <%= c.seen ? '' : 'unseen' %>" href="/partits/<%= c.match_id %>">
    <span class="item-main"><%= c.seen ? '' : '🆕 ' %><b><%= c.label || 'Partit' %></b> <span class="muted"><%= title(c.home_name) %> – <%= title(c.away_name) %></span></span>
    <span class="item-sub"><%= c.type === 'canvi' ? `🔁 ${c.before} → ${c.after}` : c.type === 'nou' ? `🆕 Nou: ${c.after}` : `🗑️ Ja no surt (era ${c.before})` %> · <span class="muted"><%= when(c.detected_at) %></span></span>
  </a>
<% }) %>
</section>
<section class="card">
  <h2>Darreres lectures</h2>
  <% runs.forEach((r) => { %><p class="small"><%= r.ok ? '✓' : r.finished_at ? '⚠️' : '⏳' %> <%= when(r.started_at) %> · <%= r.matches %> partits · <%= r.changes %> canvis · <%= r.new_blocks %> bloquejos nous<% if (r.errors) { %><br><span class="bad"><%= r.errors.split('\n').slice(0, 3).join(' · ') %></span><% } %></p><% }) %>
  <% if (!runs.length) { %><p class="muted">Encara no s'ha llegit mai. <%= isCoord ? 'Prem «Sincronitzar ara».' : '' %></p><% } %>
</section>
<%- include('partials/foot') %>
