# Port i adreça pública (s'usa als enllaços dels correus)
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=production

# Secret llarg i aleatori per signar la sessió (obligatori en producció)
SESSION_SECRET=posa-aqui-una-cadena-llarga-i-aleatoria
# true si es serveix per HTTPS (Railway sí). TRUST_PROXY=1 darrere d'un proxy (Railway sí).
COOKIE_SECURE=false
TRUST_PROXY=

# Primer coordinador: es crea en arrencar si encara no existeix (canviar-ho després no en modifica la contrasenya)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Coordinador

# Base de dades SQLite. A Railway: volum muntat a /data → DB_PATH=/data/calendar.db
DB_PATH=./data/calendar.db

# Correu amb Brevo (Railway bloqueja l'SMTP). Sense clau, els correus només queden al registre.
# MAIL_FROM ha de ser un remitent verificat a Brevo.
BREVO_API_KEY=
MAIL_FROM=Calendari CH Ripollet <calendari@example.com>

# Sincronització
SYNC_HOUR=7
# Nom dels equips del club (expressió regular) i lligues de la RFEP a llegir
CLUB_PATTERN=ripollet
RFEP_FILTER=OK LIGA
# Actes a llegir per execució (com a màxim)
ACTA_LIMIT=60
